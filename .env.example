# required — generate a random secret: `openssl rand -base64 32`
AUTH_SECRET=****

# required — https://platform.openai.com/api-keys
OPENAI_API_KEY=****

# required — postgres connection string
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/chatbot

# optional — enables resumable streams and IP rate limiting
REDIS_URL=redis://localhost:6379
